<resources>
    <style name="Theme.PhoneAgent" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PhoneAgent.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.PhoneAgent</item>
    </style>
</resources>
